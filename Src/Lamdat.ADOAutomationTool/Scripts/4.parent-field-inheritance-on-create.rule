// Parent Field Inheritance on Work Item Create
// This script runs when a new work item is created and inherits fields from its DIRECT parent
// 
// Assumption: Parent already has the correct values inherited from Epic (via scheduled script or epic inheritance)
// This provides a simpler, faster inheritance path without traversing the entire hierarchy
//
// Hierarchy Support:
// - Epic -> Feature
// - Feature -> (PBI, Bug, Glitch, Task)
// - PBI -> (Bug, Glitch, Task)
// - Bug/Glitch -> Task
// - Feature/PBI/Bug -> Test Case (via "Tested By" link)
// - Any parent -> Child
//
// Fields inherited: Custom.Custom.Category, Custom.ProjectCode

cancellationToken.ThrowIfCancellationRequested();

//// Only process on work item created event
//if (EventType != "workitem.created")
//{
//    return;
//}

Logger.Information($"Processing parent field inheritance on create for {Self.WorkItemType} {Self.Id}: {Self.Title}");

try
{
    // Define which work item types should inherit fields
    var inheritableTypes = new[] { "Feature", "Product Backlog Item", "Bug", "Glitch", "Task" };

    if (!inheritableTypes.Contains(Self.WorkItemType))
    {
        Logger.Debug($"Work item type '{Self.WorkItemType}' does not inherit fields - skipping");
        return;
    }

    // Fields to inherit
    var fieldsToInherit = new[] { "Labs.Category", "Labs.ProjectCode" };

    // Check if work item has a parent
    if (Self.Parent == null)
    {
        Logger.Debug($"{Self.WorkItemType} {Self.Id} has no parent - cannot inherit fields");
        return;
    }

    // Get the direct parent work item
    var parentWorkItem = await Client.GetWorkItem(Self.Parent.RelatedWorkItemId);
    
    if (parentWorkItem == null || parentWorkItem.Id == 0)
    {
        Logger.Warning($"Could not retrieve parent work item {Self.Parent.RelatedWorkItemId} for {Self.WorkItemType} {Self.Id}");
        return;
    }

    Logger.Debug($"Parent of {Self.WorkItemType} {Self.Id} is {parentWorkItem.WorkItemType} {parentWorkItem.Id}");

 
    
    // Inherit fields from parent
    bool fieldsInherited = false;

    foreach (var fieldName in fieldsToInherit)
    {
        var parentFieldValue = parentWorkItem.GetField<string>(fieldName);

        if (!string.IsNullOrEmpty(parentFieldValue))
        {
            var currentValue = Self.GetField<string>(fieldName);

            // Only update if current field is empty or different from parent
            if (string.IsNullOrEmpty(currentValue) || currentValue != parentFieldValue)
            {
                Self.SetField(fieldName, parentFieldValue);
                fieldsInherited = true;
                Logger.Debug($"Inherited {fieldName} = '{parentFieldValue}' from {parentWorkItem.WorkItemType} {parentWorkItem.Id}");
            }
            else
            {
                Logger.Debug($"{fieldName} already has correct value '{currentValue}'");
            }
        }
        else
        {
            Logger.Debug($"Parent {parentWorkItem.WorkItemType} {parentWorkItem.Id} has no value for {fieldName}");
        }
    }

    if (fieldsInherited)
    {
        await Client.SaveWorkItem(Self);
        Logger.Information($"Successfully inherited fields from {parentWorkItem.WorkItemType} {parentWorkItem.Id} to {Self.WorkItemType} {Self.Id}");
    }
    else
    {
        Logger.Debug($"No fields to inherit for {Self.WorkItemType} {Self.Id}");
    }
}
catch (Exception ex)
{
    Logger.Error(ex, $"Error inheriting fields for {Self.WorkItemType} {Self.Id}: {ex.Message}");
}
